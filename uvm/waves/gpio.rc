; uvm/waves/gpio.rc -- nWave signal restore for the active GPIO UVM tests.
; Load: make -C uvm verdi TEST=<test> (picked up automatically), or
;       Verdi -> File -> Restore Signal.
; All paths verified against tb_gpio_uvm.sv, gpio_axi_if.sv, gpio_pin_if.sv,
; gpio_wrapper.sv, and the generate-block hierarchy.
; $$top resolves to tb_gpio_uvm (the single FSDB top).
; See uvm/waves/README.md for a guided walkthrough.
windowTimeUnit 1ns
signalSpacing 3

; ============================================================================
; Group 1: Clock and reset
; Start here to orient any trace. aresetn goes high after 10 falling edges;
; all drivers wait for this before issuing requests.
; ============================================================================
addGroup "01_clock_reset"
addSignal -h 15 $$top/clk
addSignal -h 15 $$top/aresetn

; ============================================================================
; Group 2: GPIO pad model (binary radix to expose X on contention)
; pad_mode=1 in plan tests (SOC-027/028/029), 0 in smoke/pipeline/factory.
; external_enable/external_value: driven by gpio_pin_driver.
; output_enable: wired from dut.dir_reg (verification-only RTL probe).
; gpio_out: registered output from OUT & DIR.
; pad: tri0 resolution of gpio_out (via OE) and external driver.
; gpio_in: equals pad when pad_mode=1, equals external_value when pad_mode=0.
; in_sync: RTL's input synchroniser register (one cycle behind gpio_in).
; Contention (SOC-028) shows X on the conflicting pad bit.
; ============================================================================
addGroup "02_GPIO_pads_binary"
addSignal -h 15 $$top/pins/pad_mode
addSignal -h 15 -BIN $$top/pins/external_enable
addSignal -h 15 -BIN $$top/pins/external_value
addSignal -h 15 -BIN $$top/pins/output_enable
addSignal -h 15 -BIN $$top/pins/gpio_out
addSignal -h 15 -BIN $$top/pins/pad
addSignal -h 15 -BIN $$top/pins/gpio_in
addSignal -h 15 -BIN $$top/dut/in_sync

; ============================================================================
; Group 3: GPIO register state
; out_reg/dir_reg: the two writable registers inside gpio_wrapper.
; in_sync: input synchroniser (also in group 2 for cross-reference).
; wstate/rstate: wrapper FSM states; use to correlate handshakes with
;   register updates. W: 0=IDLE 1=DATA 2=RESP. R: 0=IDLE 1=RESP.
; ============================================================================
addGroup "03_GPIO_registers"
addSignal -h 15 -HEX $$top/dut/out_reg
addSignal -h 15 -HEX $$top/dut/dir_reg
addSignal -h 15 -BIN $$top/dut/in_sync
addSignal -h 15 -UDEC $$top/dut/wstate
addSignal -h 15 -UDEC $$top/dut/rstate

; ============================================================================
; Group 4: AXI write address channel (AW)
; Driver issues awvalid; DUT asserts awready when it can accept the address.
; awaddr[11:0]: 0x000=OUT, 0x004=IN(read-only), 0x008=DIR.
; Stall counting: scoreboard increments aw_stalls each cycle awvalid&&!awready.
; ============================================================================
addGroup "04_AXI_write_address_AW"
addSignal -h 15 $$top/axi/awvalid
addSignal -h 15 $$top/axi/awready
addSignal -h 15 -HEX $$top/axi/awaddr
addSignal -h 15 -HEX $$top/axi/awid
addSignal -h 15 -UDEC $$top/axi/awlen
addSignal -h 15 -UDEC $$top/axi/awsize
addSignal -h 15 -BIN $$top/axi/awburst

; ============================================================================
; Group 5: AXI write data channel (W)
; wstrb[0]=0: write ignored (zero_strobes counter).
; wstrb!=0 but wstrb[0]=0: upper-only strobe, also ignored (ignored_upper_strobes).
; wdata[7:0] is the byte written to OUT or DIR (8-pin device).
; ============================================================================
addGroup "05_AXI_write_data_W"
addSignal -h 15 $$top/axi/wvalid
addSignal -h 15 $$top/axi/wready
addSignal -h 15 -HEX $$top/axi/wdata
addSignal -h 15 -BIN $$top/axi/wstrb

; ============================================================================
; Group 6: AXI write response channel (B)
; bresp: 2'b00=OKAY (valid register write), 2'b10=SLVERR (IN write or
; invalid offset). bready backpressure is exercised by the pipeline driver.
; ============================================================================
addGroup "06_AXI_write_response_B"
addSignal -h 15 $$top/axi/bvalid
addSignal -h 15 $$top/axi/bready
addSignal -h 15 -HEX $$top/axi/bid
addSignal -h 15 -BIN $$top/axi/bresp

; ============================================================================
; Group 7: AXI read address channel (AR)
; araddr[11:0]: 0x000=OUT, 0x004=IN, 0x008=DIR; anything else -> SLVERR.
; IN is sampled at AR acceptance and reflects the previous rising edge value.
; ============================================================================
addGroup "07_AXI_read_address_AR"
addSignal -h 15 $$top/axi/arvalid
addSignal -h 15 $$top/axi/arready
addSignal -h 15 -HEX $$top/axi/araddr
addSignal -h 15 -HEX $$top/axi/arid
addSignal -h 15 -UDEC $$top/axi/arlen
addSignal -h 15 -UDEC $$top/axi/arsize
addSignal -h 15 -BIN $$top/axi/arburst

; ============================================================================
; Group 8: AXI read response channel (R)
; rdata: returned register value. rresp=2'b10 for invalid offsets.
; rready backpressure exercised by pipeline driver (r_stalls counter).
; ============================================================================
addGroup "08_AXI_read_response_R"
addSignal -h 15 $$top/axi/rvalid
addSignal -h 15 $$top/axi/rready
addSignal -h 15 -HEX $$top/axi/rid
addSignal -h 15 -HEX $$top/axi/rdata
addSignal -h 15 -BIN $$top/axi/rresp

; ============================================================================
; Group 9: Output glitch checker (tb-level event monitor)
; Tracks which pad bits are allowed to change on each clock edge based on
; the accepted AW/W transaction. Any transition outside allowed_changes or
; between clock edges fires GPIO_INJECT_GLITCH / GPIO_GLITCH error.
; observed_awaddr: last accepted AW address (determines which register).
; allowed_changes: pad bits that may transition on this edge.
; changed_this_edge: bits that actually changed (must be subset of allowed).
; previous_output: last captured gpio_out value (change detection baseline).
; ============================================================================
addGroup "09_output_glitch_checker"
addSignal -h 15 -HEX $$top/observed_awaddr
addSignal -h 15 -BIN $$top/allowed_changes
addSignal -h 15 -BIN $$top/changed_this_edge
addSignal -h 15 -BIN $$top/previous_output
