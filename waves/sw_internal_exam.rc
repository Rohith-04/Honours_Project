; waves/sw_internal_exam.rc -- nWave signal restore for
; `make verdi LEVEL=sw IP=internal_exam`
; (tb_soc_sw + VeeR + veer_axi_adapter + honours_soc).
;
; Hierarchy verified from tb_soc_sw.sv force statements:
;   tb_soc_sw / u_adapter  (veer_axi_adapter)
;   tb_soc_sw / dut        (honours_soc)
;     / gen_xbar_2x7 / u_xbar  (axi_interconnect_wrap_2x7)
;
; Note: sw_uart.rc uses $$top/dut/u_xbar/... which skips the generate
; block label and will not resolve. The correct path includes gen_xbar_2x7.
;
; Five groups:
;   clk_rst        -- clock and reset
;   lsu_axi_64b    -- 64-bit LSU write channel leaving VeeR; lsu_awaddr
;                     shows 0x1000_0000 on each uart_putc() call,
;                     lsu_wdata[7:0] holds the ASCII character byte
;   adapter_soc32  -- 32-bit write channel inside veer_axi_adapter;
;                     m_awaddr and m_wdata carry the same byte after
;                     width conversion
;   uart_m01       -- crossbar output port to uart_wrapper (slave m01);
;                     m01_axi_wdata[7:0] is the THR byte -- right-click
;                     in Verdi and set Radix -> ASCII to read the string
;                     "Design Verification Lab Internal" one char per write
;   trace_ebreak   -- trace port and ebreak flag used by the harness
;
; $$top resolves to tb_soc_sw (the single FSDB top).

addGroup "-e" "clk_rst"
addSignal -h 15 $$top/clk
addSignal -h 15 $$top/aresetn

addGroup "-e" "lsu_axi_64b"
addSignal -h 15 $$top/lsu_awvalid
addSignal -h 15 $$top/lsu_awready
addSignal -h 15 -HEX $$top/lsu_awaddr
addSignal -h 15 $$top/lsu_awid
addSignal -h 15 $$top/lsu_awsize
addSignal -h 15 $$top/lsu_wvalid
addSignal -h 15 $$top/lsu_wready
addSignal -h 15 -HEX $$top/lsu_wdata
addSignal -h 15 $$top/lsu_wstrb
addSignal -h 15 $$top/lsu_wlast
addSignal -h 15 $$top/lsu_bvalid
addSignal -h 15 $$top/lsu_bready
addSignal -h 15 $$top/lsu_bresp

addGroup "-e" "adapter_soc32"
addSignal -h 15 $$top/u_adapter/state
addSignal -h 15 $$top/u_adapter/m_awvalid
addSignal -h 15 $$top/u_adapter/m_awready
addSignal -h 15 -HEX $$top/u_adapter/m_awaddr
addSignal -h 15 $$top/u_adapter/m_awsize
addSignal -h 15 $$top/u_adapter/m_wvalid
addSignal -h 15 $$top/u_adapter/m_wready
addSignal -h 15 -HEX $$top/u_adapter/m_wdata
addSignal -h 15 $$top/u_adapter/m_wstrb
addSignal -h 15 $$top/u_adapter/m_wlast
addSignal -h 15 $$top/u_adapter/m_bvalid
addSignal -h 15 $$top/u_adapter/m_bready
addSignal -h 15 $$top/u_adapter/m_bresp

addGroup "-e" "uart_m01"
addSignal -h 15 $$top/uart_tx_mon
addSignal -h 15 $$top/uart_irq_mon
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_awvalid
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_awready
addSignal -h 15 -HEX $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_awaddr
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_wvalid
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_wready
addSignal -h 15 -HEX $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_wdata
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_wstrb
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_bvalid
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_bready
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_bresp
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_arvalid
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_arready
addSignal -h 15 -HEX $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_araddr
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_rvalid
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_rready
addSignal -h 15 -HEX $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_rdata
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_rresp
addSignal -h 15 $$top/dut/gen_xbar_2x7/u_xbar/m01_axi_rlast

addGroup "-e" "trace_ebreak"
addSignal -h 15 $$top/tr_valid
addSignal -h 15 -HEX $$top/tr_insn
addSignal -h 15 $$top/tr_exc
addSignal -h 15 $$top/tr_cause
addSignal -h 15 $$top/saw_ebreak
