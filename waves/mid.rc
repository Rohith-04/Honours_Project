Magic 271485
Revision Verdi_U-2023.03-SP1

; ============================================================
; tb_core_uart -- Verdi Wave RC (middle + SW debug)
; Location: waves/mid.rc  (survives make clean)
; NOTE: absolute paths must NOT use -holdScope (it double-prepends
; the scope and lands every signal in unknownSignals.txt).
; ============================================================

; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 0 1600 900 220 100

; FSDB file
openDirFile -d / -i 0 "" "/home/student/Desktop/Honours-34/Honours_Project/run/mid/tb_core_uart.fsdb"

; signal spacing
signalSpacing 5

zoom 0.000000 500000.000000
cursor 0.000000
marker 0.000000

top 0
markerPos 0

COMPLEX_EVENT_BEGIN
COMPLEX_EVENT_END

curSTATUS ByChange

; ============================================================
; Group 1: Clock & Reset + SoC pins
; ============================================================
addGroup "Clock & Reset"
addSignal -h 15 /tb_core_uart/clk
addSignal -h 15 -holdScope rst_n
addSignal -h 15 /tb_core_uart/dut/uart_tx
addSignal -h 15 /tb_core_uart/dut/uart_rx
addSignal -h 15 /tb_core_uart/dut/uart_irq

; ============================================================
; Group 2: VeeR fetch (CPU -> xbar) + width fields
; ============================================================
addGroup "VeeR fetch"
addSignal -h 15 /tb_core_uart/dut/ifu_arvalid
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/ifu_araddr[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/ifu_arlen[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/ifu_arsize[2:0]
addSignal -h 15 /tb_core_uart/dut/ifu_arready
addSignal -h 15 /tb_core_uart/dut/lsu_arvalid
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/lsu_araddr[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/lsu_arsize[2:0]
addSignal -h 15 /tb_core_uart/dut/lsu_awvalid
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/lsu_awaddr[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/lsu_wstrb[7:0]
addSignal -h 15 /tb_core_uart/dut/ifu_rvalid
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/ifu_rdata[63:0]

; ============================================================
; Group 2b: CPU halt/debug status
; ============================================================
addGroup "CPU halt"
addSignal -h 15 /tb_core_uart/dut/u_veer/o_cpu_halt_status
addSignal -h 15 /tb_core_uart/dut/u_veer/o_debug_mode_status
addSignal -h 15 /tb_core_uart/dut/u_veer/mpc_debug_halt_ack
addSignal -h 15 /tb_core_uart/dut/u_veer/mpc_debug_run_ack

; ============================================================
; Group 3: m00 true RAM (xbar -> mem) + burst fields
; ============================================================
addGroup "m00 true RAM"
addSignal -h 15 /tb_core_uart/dut/m00_arvalid
addSignal -h 15 /tb_core_uart/dut/m00_arready
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m00_araddr[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m00_arlen[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m00_arsize[2:0]
addSignal -h 15 /tb_core_uart/dut/m00_rvalid
addSignal -h 15 /tb_core_uart/dut/m00_rready
addSignal -h 15 /tb_core_uart/dut/m00_rlast
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m00_rdata[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m00_rresp[1:0]
addSignal -h 15 /tb_core_uart/dut/m00_awvalid
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m00_awaddr[31:0]
addSignal -h 15 /tb_core_uart/dut/m00_bvalid

; ============================================================
; Group 4: m05 UART (xbar -> uart_wrap)
; ============================================================
addGroup "m05 UART"
addSignal -h 15 /tb_core_uart/dut/m05_awvalid
addSignal -h 15 /tb_core_uart/dut/m05_awready
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m05_awaddr[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m05_wdata[31:0]
addSignal -h 15 /tb_core_uart/dut/m05_bvalid
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m05_bresp[1:0]
addSignal -h 15 /tb_core_uart/dut/m05_arvalid
addSignal -h 15 /tb_core_uart/dut/m05_arready
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m05_rdata[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/m05_rresp[1:0]

; ============================================================
; Group 4b: s03 hooks (TB-driven, no force)
; ============================================================
addGroup "s03 hooks"
addSignal -h 15 /tb_core_uart/tb_s03_awvalid
addSignal -h 15 /tb_core_uart/tb_s03_awready
addSignal -h 15 /tb_core_uart/tb_s03_wvalid
addSignal -h 15 /tb_core_uart/tb_s03_wready
addSignal -h 15 /tb_core_uart/tb_s03_bvalid
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/tb_s03_bresp[1:0]
addSignal -h 15 /tb_core_uart/tb_s03_arvalid
addSignal -h 15 /tb_core_uart/tb_s03_arready
addSignal -h 15 /tb_core_uart/tb_s03_rvalid

; ============================================================
; Group 5: xbar FSM + arbiter
; ============================================================
addGroup "xbar FSM"
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/u_xbar/axi_interconnect_inst/state_reg[2:0]
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/u_xbar/axi_interconnect_inst/grant
addSignal -h 15 /tb_core_uart/dut/u_xbar/axi_interconnect_inst/grant_valid
addSignal -h 15 -UNSIGNED -HEX /tb_core_uart/dut/u_xbar/axi_interconnect_inst/grant_encoded
