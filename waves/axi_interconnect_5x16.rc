; ============================================================
; AXI Interconnect 5x16 Testbench – Verdi Wave RC
; Location: waves/axi_interconnect_5x16.rc  (survives make clean)
;
; Signals grouped by function:
;   1.  Clock & Reset
;   2.  Master 0 (s00) AW / W / B
;   3.  Master 0 (s00) AR / R
;   4.  Master 1 (s01) AW / W / B
;   5.  Master 1 (s01) AR / R
;   6.  Master 2 (s02) AW / W / B
;   7.  Master 2 (s02) AR / R
;   8.  Master 3 (s03) AW / W / B
;   9.  Master 3 (s03) AR / R
;  10.  Master 4 (s04) AW / W / B
;  11.  Master 4 (s04) AR / R
;  12.  Slave 0  (m00) AW / W / B
;  13.  Slave 0  (m00) AR / R
;  14.  Slave 1  (m01) AW / W / B
;  15.  Slave 1  (m01) AR / R
;  16.  Arbiter (write + read grant)
;  17.  Interconnect FSM
; ============================================================

; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 0 1600 900 220 100

; FSDB file
openDirFile -d / -i 0 "" "/home/student/Desktop/Honours-34/Honours_Project/run/interconnect/tb_axi_interconnect_5x16.fsdb"

; signal spacing
signalSpacing 5

zoom 0.000000 500000.000000
cursor 0.000000
marker 0.000000

top 0
markerPos 0

COMPLEX_EVENT_BEGIN
COMPLEX_EVENT_END

curSTATUS ByChange

; ============================================================
; Group 1: Clock & Reset
; ============================================================
addGroup "Clock & Reset"
addSignal -h 15 /tb_axi_interconnect_5x16/clk
addSignal -h 15 -holdScope rst

; ============================================================
